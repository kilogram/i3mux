#!/usr/bin/env bash
# i3mux-rofi - rofi menu for i3mux
#
# Bind in ~/.config/sway/config:
#   bindsym $mod+m exec i3mux-rofi
#
# The menu header shows the focused workspace's session. In a bound
# workspace, detach and kill act on that session; a resumable one (its
# windows went away with an earlier Sway) offers resume first. In an unbound
# one, type a hostname (or nothing for local) to activate it, or pick
# attach, list or kill. Actions match without regard to case. Attach, detach
# and resume show i3mux's own output in a notification.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/i3mux"
LAST_REMOTE_FILE="$CONFIG_DIR/last_remote"
mkdir -p "$CONFIG_DIR"

# `i3mux status` exits with this when the focused workspace is not bound.
EXIT_UNBOUND=3

last_remote() {
    [ -f "$LAST_REMOTE_FILE" ] && cat "$LAST_REMOTE_FILE" || true
}

save_last_remote() {
    printf '%s\n' "$1" > "$LAST_REMOTE_FILE"
}

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "i3mux" "$1" || true
}

# One row per session on this machine, on every bound host, and on the last
# remote host, e.g.
#   ws3  (deepthought)  workspace 3, 1 window
#   ws5  (deepthought)  workspace 5, resumable, 3 terminals backed up
#   ws4  (local)        detached, 3 terminals saved
# Warnings about unreachable hosts go to stderr.
all_sessions() {
    local remote
    remote=$(last_remote)
    if [ -n "$remote" ] && i3mux sessions --all --remote "$remote"; then
        return
    fi
    # No remembered host, or i3mux rejected it.
    i3mux sessions --all || true
}

# Split "name  (host)  ..." into SEL_NAME and SEL_HOST.
parse_row() {
    SEL_NAME=${1%% *}
    local rest=${1#*(}
    SEL_HOST=${rest%%)*}
}

host_args() {
    if [ "$1" = "local" ]; then echo ""; else echo "--remote $1"; fi
}

pick_session() {
    local prompt=$1 sessions
    sessions=$(all_sessions 2>/dev/null)
    [ -z "$sessions" ] && { notify "No sessions"; exit 0; }
    local chosen
    chosen=$(printf '%s\n' "$sessions" | rofi -dmenu -i -p "$prompt") || exit 0
    [ -z "$chosen" ] && exit 0
    parse_row "$chosen"
}

confirm_kill() {
    local confirm
    confirm=$(printf 'yes\nno\n' | rofi -dmenu -i -p "Kill $SEL_NAME on $SEL_HOST?") || exit 0
    [ "${confirm,,}" = "yes" ]
}

show_list() {
    local sessions warnings
    warnings=$(mktemp)
    sessions=$(all_sessions 2>"$warnings")
    local mesg="Pick a session bound here to go to its workspace"
    [ -s "$warnings" ] && mesg="$mesg. $(tr '\n' ' ' < "$warnings")"
    rm -f "$warnings"
    [ -z "$sessions" ] && { rofi -e "No sessions. $mesg"; exit 0; }
    local chosen ws
    chosen=$(printf '%s\n' "$sessions" | rofi -dmenu -i -p "Sessions" -mesg "$mesg") || exit 0
    [ -z "$chosen" ] && exit 0
    if ! ws=$(row_workspace "$chosen"); then
        parse_row "$chosen"
        notify "$SEL_NAME is not bound to a workspace here; use attach"
        exit 0
    fi
    # Sway command syntax: quote the name and escape its quotes.
    swaymsg -q "workspace \"${ws//\"/\\\"}\"" || rofi -e "Cannot go to workspace $ws"
}

# Print the workspace of a bound row:
#   ws3  (deepthought)  workspace 3, 1 window, 2 orphans           ->  3
#   ws5  (deepthought)  workspace 5, resumable, 1 terminal backed up  ->  5
#   ws6  (local)        workspace 6, resumable, no backup             ->  6
# Fails for a row that is not bound here.
row_workspace() {
    local re='\)  workspace (.+), ([0-9]+ windows?(, [0-9]+ orphans?)?|resumable, ([0-9]+ terminals? backed up|no backup))$'
    [[ $1 =~ $re ]] || return 1
    printf '%s\n' "${BASH_REMATCH[1]}"
}

# Whether the first line of `i3mux status` is a resumable row.
row_resumable() {
    local re='\)  workspace .+, resumable, '
    [[ ${1%%$'\n'*} =~ $re ]]
}

# Show the output of a command that worked, if it printed anything.
notify_output() {
    [ -n "$1" ] && notify "$1" || true
}

rc=0
status=$(i3mux status 2>&1) || rc=$?
case $rc in
    0) bound=1 ;;
    "$EXIT_UNBOUND") bound=0 ;;
    *) rofi -e "i3mux status failed: $status"; exit 1 ;;
esac

if [ "$bound" = 1 ]; then
    # list first: Enter on an untouched menu must not detach or kill.
    menu="list
detach
kill"
    # resume first in a resumable workspace: it only brings windows back.
    row_resumable "$status" && menu="resume
$menu"
    mesg=$status
else
    menu="attach
list
kill"
    remote=$(last_remote)
    [ -n "$remote" ] && menu="$remote
$menu"
    mesg="$status. Enter = local, type a host for remote, or pick an action"
fi

selection=$(printf '%s\n' "$menu" | rofi -dmenu -i -p "i3mux" -mesg "$mesg") || exit 0
[ -z "$selection" ] && selection="local"

case "${selection,,}" in
    attach)
        pick_session "Attach"
        [ "$SEL_HOST" != "local" ] && save_last_remote "$SEL_HOST"
        # shellcheck disable=SC2046
        if output=$(i3mux attach $(host_args "$SEL_HOST") --session "$SEL_NAME" 2>&1); then
            notify_output "$output"
        else
            rofi -e "Attach failed: $output"
        fi
        ;;
    detach)
        # A detach that saved nothing (another machine took the session, or
        # it ended) still exits 0; its output says so.
        if output=$(i3mux detach 2>&1); then
            notify_output "$output"
        else
            rofi -e "Detach failed: $output"
        fi
        ;;
    resume)
        if output=$(i3mux terminal 2>&1); then
            notify_output "$output"
        else
            rofi -e "Resume failed: $output"
        fi
        ;;
    list)
        show_list
        ;;
    kill)
        if [ "$bound" = 1 ]; then
            # Plain 'i3mux kill' ends the focused workspace's session.
            parse_row "$status"
            confirm_kill || exit 0
            kill_args=()
        else
            pick_session "Kill"
            confirm_kill || exit 0
            # shellcheck disable=SC2207
            kill_args=($(host_args "$SEL_HOST") --session "$SEL_NAME")
        fi
        if error=$(i3mux kill "${kill_args[@]}" 2>&1); then
            notify "Killed $SEL_NAME"
        else
            rofi -e "Kill failed: $error"
        fi
        ;;
    local)
        if ! error=$(i3mux activate 2>&1); then
            rofi -e "Activate failed: $error"
        fi
        ;;
    *)
        # Remember the host only once it works, so a typo cannot hide the
        # remembered host's sessions from list, attach and kill.
        if error=$(i3mux activate --remote "$selection" 2>&1); then
            save_last_remote "$selection"
        else
            rofi -e "Activate on $selection failed: $error"
        fi
        ;;
esac
