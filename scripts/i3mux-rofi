#!/usr/bin/env bash
# i3mux-rofi - rofi menu for i3mux
#
# Bind in ~/.config/sway/config:
#   bindsym $mod+m exec i3mux-rofi
#
# Menu: type a hostname (or nothing for local) to activate the focused
# workspace, or pick Detach / Attach / List / Kill.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/i3mux"
LAST_REMOTE_FILE="$CONFIG_DIR/last_remote"
mkdir -p "$CONFIG_DIR"

last_remote() {
    [ -f "$LAST_REMOTE_FILE" ] && cat "$LAST_REMOTE_FILE" || true
}

save_last_remote() {
    printf '%s\n' "$1" > "$LAST_REMOTE_FILE"
}

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "i3mux" "$1" || true
}

# One line per session, prefixed with the host it was listed from:
#   local|ws4  (local)  2 windows
#   deepthought|ws3  (deepthought)  detached, 3 terminals saved
all_sessions() {
    i3mux sessions 2>/dev/null | sed 's/^/local|/' || true
    local remote
    remote=$(last_remote)
    if [ -n "$remote" ]; then
        i3mux sessions --remote "$remote" 2>/dev/null | sed "s/^/$remote|/" || true
    fi
}

# Split "host|name  (...)" into HOST and NAME.
parse_selection() {
    SEL_HOST=${1%%|*}
    local rest=${1#*|}
    SEL_NAME=${rest%% *}
}

host_args() {
    if [ "$1" = "local" ]; then echo ""; else echo "--remote $1"; fi
}

pick_session() {
    local prompt=$1 sessions
    sessions=$(all_sessions)
    [ -z "$sessions" ] && { notify "No sessions"; exit 0; }
    local chosen
    chosen=$(printf '%s\n' "$sessions" | rofi -dmenu -p "$prompt") || exit 0
    [ -z "$chosen" ] && exit 0
    parse_selection "$chosen"
}

menu="Detach
Attach
List
Kill"
remote=$(last_remote)
[ -n "$remote" ] && menu="$remote
$menu"

selection=$(printf '%s\n' "$menu" | rofi -dmenu -p "i3mux" \
    -mesg "Enter = local, type a host for remote, or pick an action") || exit 0
[ -z "$selection" ] && selection="local"

case "$selection" in
    Attach)
        pick_session "Attach"
        [ "$SEL_HOST" != "local" ] && save_last_remote "$SEL_HOST"
        # shellcheck disable=SC2046
        if ! error=$(i3mux attach $(host_args "$SEL_HOST") --session "$SEL_NAME" 2>&1); then
            rofi -e "Attach failed: $error"
        fi
        ;;
    Detach)
        if error=$(i3mux detach 2>&1); then
            notify "Workspace detached"
        else
            rofi -e "Detach failed: $error"
        fi
        ;;
    List)
        sessions=$(all_sessions)
        [ -z "$sessions" ] && { rofi -e "No sessions"; exit 0; }
        printf '%s\n' "$sessions" | rofi -dmenu -p "Sessions" -mesg "Read-only" || true
        ;;
    Kill)
        pick_session "Kill"
        confirm=$(printf 'Yes\nNo\n' | rofi -dmenu -p "Kill $SEL_NAME on $SEL_HOST?") || exit 0
        [ "$confirm" = "Yes" ] || exit 0
        # shellcheck disable=SC2046
        if error=$(i3mux kill $(host_args "$SEL_HOST") --session "$SEL_NAME" 2>&1); then
            notify "Killed $SEL_NAME"
        else
            rofi -e "Kill failed: $error"
        fi
        ;;
    local)
        if ! error=$(i3mux activate 2>&1); then
            rofi -e "Activate failed: $error"
        fi
        ;;
    *)
        save_last_remote "$selection"
        if ! error=$(i3mux activate --remote "$selection" 2>&1); then
            rofi -e "Activate on $selection failed: $error"
        fi
        ;;
esac
